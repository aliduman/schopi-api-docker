# Üretimde bu değerleri Heroku config var olarak tanımlayın.
# Repoya gerçek değer yazmayın.

DB_HOST=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# Mevcut oturumların düşmemesi için bugünkü imza anahtarıyla aynı olmalı.
JWT_SECRET=

ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Ek CORS origin (virgülle). Yerleşik listeye eklenir. * yok sayılır.
# Örnek iOS webview: capacitor://localhost,ionic://localhost
CORS_ALLOWED_ORIGINS=
